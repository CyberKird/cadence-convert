{
  "name": "cadence-convert",
  "version": "1.1.1",
  "description": "Video conversion for Premiere and compressed delivery",
  "main": "./out/main/index.js",
  "author": "CyberKird",
  "desktopName": "com.cyberkird.cadenceconvert",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "start": "electron-vite preview",
    "fetch:ffmpeg": "node scripts/fetch-ffmpeg.mjs",
    "pack:win": "npm run fetch:ffmpeg && npm run build && electron-builder --win --publish never"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
